@model SchoolMvc.Models.EncryptionViewModel
@{
    ViewData["Title"] = "";
    ViewData["Page"] = "encrypt";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (!string.IsNullOrEmpty(Context.Session.GetString("SelectedMethodName")))
{
    <div style="background: var(--surface2); border-left: 3px solid var(--red); padding: 10px; margin-bottom: 20px;">
        <span style="color: var(--red);">📖 Активен метод:</span>
        <strong>@Context.Session.GetString("SelectedMethodName")</strong>
        <span style="color: var(--text-muted);">(Seed: @Context.Session.GetString("SelectedCustomSeed"))</span>
        <a href="/Account/ClearSelectedMethod" style="margin-left: 15px; color: var(--red);">[Изчисти]</a>
    </div>
}
<div class="page enc-page">

    <h1 class="enc-title">
        <span id="page-title">@(Model.DecryptMode ? "ДЕКРИПТИРАНЕ" : "КРИПТИРАНЕ")</span>
    </h1>

    <!-- ЕДИНСТВЕНА ФОРМА – РАЗЛИЧНИ ПОЛЕТА В ЗАВИСИМОСТ ОТ РЕЖИМА -->
    <form asp-action="Index" asp-controller="Encryption" method="post" enctype="multipart/form-data" id="mainForm">

        <div class="enc-switch">
            <label class="switch">
                <input type="checkbox" id="decryptMode" name="decryptMode" value="true"
                       @(Model.DecryptMode ? "checked" : "")
                       onchange="toggleMode()" />
                <span class="slider"></span>
            </label>
            <span class="switch-label" id="switch-label">
                @(Model.DecryptMode ? "РЕЖИМ: ДЕКРИПТИРАНЕ" : "РЕЖИМ: КРИПТИРАНЕ")
            </span>
        </div>

        <!-- ПАРОЛА -->
        @if (string.IsNullOrEmpty(Context.Session.GetString("SelectedMethodId")))
        {
            <div class="enc-password">
                <label class="enc-label" for="password">ПАРОЛА</label>
                <input class="enc-input" type="text" id="password" name="password"
                       value="@Model.Password" placeholder="въведи парола..." />
            </div>
        }
        else
        {
            <div class="enc-password">
                <label class="enc-label">ПАРОЛА (от метода)</label>
                <input class="enc-input" type="text" value="@Context.Session.GetString("SelectedCustomPassword")" disabled style="opacity:0.7;" />
                <input type="hidden" name="password" value="@Context.Session.GetString("SelectedCustomPassword")" />
            </div>
        }

        <!-- ЦЕЛЕВО ИМЕ (САМО ПРИ КРИПТИРАНЕ) -->
        <div id="targetUsernameBlock" style="@(Model.DecryptMode ? "display:none;" : "")">
            @if (!string.IsNullOrEmpty(Context.Session.GetString("UserId")))
            {
                <div class="enc-password">
                    <label class="enc-label" for="targetUsername">ЦЕЛЕВО ИМЕ</label>
                    <input class="enc-input" type="text" id="targetUsername" name="receiverUsername" value="everyone" />
                    <small style="color: var(--text-muted); display: block; margin-top: 5px;">
                        "everyone" - всеки може да декриптира
                    </small>
                </div>
            }
        </div>

        <!-- ДАТА НА КРИПТИРАНЕ (САМО ПРИ ДЕКРИПТИРАНЕ) -->
        <div id="targetDateBlock" style="@(Model.DecryptMode ? "" : "display:none;")">
            <div class="enc-password">
                <label class="enc-label" for="targetDate">ДАТА НА КРИПТИРАНЕ</label>
                <input class="enc-input" type="date" id="targetDate" name="targetDate" value="@DateTime.UtcNow.AddHours(2).ToString("yyyy-MM-dd")" />
                <small style="color: var(--text-muted);">Въведете датата, на която е направено криптирането</small>
            </div>
        </div>

        <!-- ВХОДЕН ТЕКСТ (при криптиране) / КРИПТОТЕКСТ (при декриптиране) -->
        <div id="inputTextBlock" style="@(Model.DecryptMode ? "display:none;" : "")">
            <label class="enc-label">ВХОДЕН ТЕКСТ</label>
            <textarea class="enc-textarea" id="inputText" name="inputText"
                      placeholder="въведи текст за обработка...">@Model.OriginalText</textarea>
        </div>

        <div id="cryptoTextBlock" style="@(Model.DecryptMode ? "" : "display:none;")">
            <label class="enc-label">КРИПТОТЕКСТ</label>
            <textarea class="enc-textarea" id="cryptoText" name="cryptoText" style="height: 150px;"
                      placeholder="постави криптирания текст...">@Model.OriginalText</textarea>
        </div>

        <div class="enc-actions">
            <label class="btn-file">
                ⬆ ИЗБЕРИ ФАЙЛ
                <input type="file" name="uploadFile" accept=".txt" onchange="showFileName(this)" />
            </label>
            <span id="file-name" style="font-family:var(--mono);font-size:13px;color:var(--text-muted);">
                няма избран файл
            </span>
            <button type="submit" class="btn-process">@(Model.DecryptMode ? "ДЕКРИПТИРАЙ ▶" : "ИЗПЪЛНИ ▶")</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="enc-error">⚠ @Model.ErrorMessage</div>
        }
    </form>

    <!-- РЕЗУЛТАТ -->
    @if (!string.IsNullOrWhiteSpace(Model.EncryptedText))
    {
        <h2 class="enc-output-title">КРИПТИРАН ТЕКСТ</h2>
        <div class="enc-output" id="encryptedText">@Model.EncryptedText</div>
        <button onclick="copyToClipboard('encryptedText')" style="margin-top: 10px; background: var(--surface2); border: 1px solid var(--red); color: var(--text); padding: 5px 10px; cursor: pointer;">📋 Копирай</button>
    }

    @if (!string.IsNullOrWhiteSpace(Model.DecryptedText))
    {
        <h2 class="enc-output-title" style="margin-top:40px;">ДЕКРИПТИРАН ТЕКСТ</h2>
        <div class="enc-output" id="decryptedText">@Model.DecryptedText</div>
        <button onclick="copyToClipboard('decryptedText')" style="margin-top: 10px; background: var(--surface2); border: 1px solid var(--red); color: var(--text); padding: 5px 10px; cursor: pointer;">📋 Копирай</button>
    }

</div>

@section Scripts {
<script>
function toggleMode() {
    const isDecrypt = document.getElementById('decryptMode').checked;
    const pageTitle = document.getElementById('page-title');
    const switchLabel = document.getElementById('switch-label');
    const targetUsernameBlock = document.getElementById('targetUsernameBlock');
    const targetDateBlock = document.getElementById('targetDateBlock');
    const inputTextBlock = document.getElementById('inputTextBlock');
    const cryptoTextBlock = document.getElementById('cryptoTextBlock');
    const submitBtn = document.querySelector('#mainForm button[type="submit"]');
    
    if (isDecrypt) {
        pageTitle.textContent = 'ДЕКРИПТИРАНЕ';
        switchLabel.textContent = 'РЕЖИМ: ДЕКРИПТИРАНЕ';
        if (targetUsernameBlock) targetUsernameBlock.style.display = 'none';
        if (targetDateBlock) targetDateBlock.style.display = 'block';
        if (inputTextBlock) inputTextBlock.style.display = 'none';
        if (cryptoTextBlock) cryptoTextBlock.style.display = 'block';
        if (submitBtn) submitBtn.textContent = 'ДЕКРИПТИРАЙ ▶';
        
        // Премахваме required от inputText и добавяме към cryptoText
        const inputText = document.getElementById('inputText');
        const cryptoText = document.getElementById('cryptoText');
        if (inputText) inputText.removeAttribute('required');
        if (cryptoText) cryptoText.setAttribute('required', 'required');
    } else {
        pageTitle.textContent = 'КРИПТИРАНЕ';
        switchLabel.textContent = 'РЕЖИМ: КРИПТИРАНЕ';
        if (targetUsernameBlock) targetUsernameBlock.style.display = 'block';
        if (targetDateBlock) targetDateBlock.style.display = 'none';
        if (inputTextBlock) inputTextBlock.style.display = 'block';
        if (cryptoTextBlock) cryptoTextBlock.style.display = 'none';
        if (submitBtn) submitBtn.textContent = 'ИЗПЪЛНИ ▶';
        
        const inputText = document.getElementById('inputText');
        const cryptoText = document.getElementById('cryptoText');
        if (inputText) inputText.setAttribute('required', 'required');
        if (cryptoText) cryptoText.removeAttribute('required');
    }
}

function showFileName(input) {
    const name = input.files[0]?.name || 'няма избран файл';
    document.getElementById('file-name').textContent = name;
}

function copyToClipboard(elementId) {
    const text = document.getElementById(elementId).innerText;
    navigator.clipboard.writeText(text);
    alert('Копирано!');
}
</script>
}