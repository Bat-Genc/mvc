@model SchoolMvc.Models.MyCapsulesViewModel
@{
    ViewData["Title"] = "Моите капсули";
}

<div class="page" style="max-width: 900px; margin: 0 auto;">
    <h1 style="color: var(--red);">🎒 МОИТЕ КАПСУЛИ</h1>
    <p style="color: var(--text-muted); margin-bottom: 25px;">Тук виждате капсулите, които сте изпратили, както и тези, насочени към вас.</p>
    <a href="/Account/Profile" class="nav-btn" style="display: inline-block; margin-bottom: 25px;">Назад към профила</a>

    <section style="margin-bottom: 40px;">
        <h2 style="color: var(--red);">Капсули, изпратени от вас</h2>
        @if (Model.SentCapsules.Any())
        {
            foreach (var capsule in Model.SentCapsules)
            {
                <div style="background: var(--surface2); padding: 18px; margin-bottom: 12px; border-left: 3px solid var(--red);">
                    <div style="font-size: 14px; color: var(--text-muted); margin-bottom: 8px;">
                        Изпратена: @capsule.CreatedAt.ToString("dd.MM.yyyy HH:mm") | Тип: @capsule.EncryptionType | Цел: @capsule.TargetUsername
                    </div>
                    <div style="font-size: 14px; color: var(--text-muted); margin-bottom: 10px;">Парола/seed: @capsule.PasswordUsed</div>
                    <div style="font-family: var(--mono); white-space: pre-wrap; word-break: break-word;">@capsule.EncryptedText</div>
                </div>
            }
        }
        else
        {
            <div style="color: var(--text-muted);">Все още нямате изпратени капсули.</div>
        }
    </section>

    <section>
        <h2 style="color: var(--red);">Капсули, насочени към вас</h2>
        @if (Model.IncomingCapsules.Any())
        {
            foreach (var capsule in Model.IncomingCapsules)
            {
                <div style="background: var(--surface2); padding: 18px; margin-bottom: 12px; border-left: 3px solid var(--red);">
                    <div style="font-size: 14px; color: var(--text-muted); margin-bottom: 8px;">
                        Изпратена: @capsule.CreatedAt.ToString("dd.MM.yyyy HH:mm") | Изпратил: @(capsule.User?.Username ?? "анонимен")
                    </div>
                    <div style="font-size: 14px; color: var(--text-muted); margin-bottom: 10px;">Парола/seed: @capsule.PasswordUsed</div>
                    <div style="font-family: var(--mono); white-space: pre-wrap; word-break: break-word;">@capsule.EncryptedText</div>
                </div>
            }
        }
        else
        {
            <div style="color: var(--text-muted);">Все още нямате капсули, насочени към вас.</div>
        }
    </section>
</div>
