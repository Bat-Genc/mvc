<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] CipherX</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="shortcut icon" type="image/webp" href="~/images/oni.webp" />
</head>
<body>
    <nav class="navbar">
    <a href="/" class="nav-home">
    <img src="~/images/oni.webp" alt="CIPHERX" class="nav-logo" />
    </a>
    <div class="nav-links">
        <a href="/Encryption" class="nav-btn @(ViewData["Page"]?.ToString() == "encrypt" ? "active" : "")">
            <span class="nav-btn-text">КРИПТИРАНЕ</span>
        </a>
        <a href="/Explanation" class="nav-btn @(ViewData["Page"]?.ToString() == "explain" ? "active" : "")">
            <span class="nav-btn-text">КАК РАБОТИ</span>
        </a>
    </div>
</nav>

    <main>
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>