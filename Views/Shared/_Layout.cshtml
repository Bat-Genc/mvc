<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] CipherX</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="shortcut icon" type="image/webp" href="~/images/oni.webp" />
</head>
<body>
    <nav class="navbar">
        <div style="display: flex; align-items: center; gap: 20px; width: 100%;">
            <a href="/" class="nav-home">
                <img src="~/images/oni.webp" alt="CIPHERX" class="nav-logo" />
            </a>
            
            <div style="display: flex; gap: 8px; flex: 1;">
    <a href="/Encryption" class="nav-btn @(ViewData["Page"]?.ToString() == "encrypt" ? "active" : "")">
        <span class="nav-btn-text">КРИПТИРАНЕ</span>
    </a>
    
    <a href="/Explanation" class="nav-btn @(ViewData["Page"]?.ToString() == "explain" ? "active" : "")">
        <span class="nav-btn-text">КАК РАБОТИ</span>
    </a>
</div>
            
            <!-- Секция за вход/изход и потребител -->
            <div style="display: flex; align-items: center; gap: 15px;">
                @if (!string.IsNullOrEmpty(Context.Session.GetString("UserId")))
                {
                    <a href="/Account/Profile" style="color: var(--red); font-family: var(--mono); text-decoration: none;">
                         <i class="fas fa-user"></i> @Context.Session.GetString("Username")
                    </a>
                    <a href="/Account/Logout" class="nav-btn" style="background: var(--red-dark);">
                        <span class="nav-btn-text">ИЗХОД</span>
                    </a>
                }
                else
                {
                    <a href="/Account/Login" class="nav-btn">
                        <span class="nav-btn-text">ВХОД</span>
                    </a>
                    <a href="/Account/Register" class="nav-btn" style="background: var(--surface2); border: 1px solid var(--red);">
                        <span class="nav-btn-text">РЕГИСТРАЦИЯ</span>
                    </a>
                }
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>